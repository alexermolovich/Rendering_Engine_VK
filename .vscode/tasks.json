{
    "tasks": [
        {
            "type": "process",
            "label": "Configure Renderer",
            "command": "cmake",
            "args": [
                "--preset",
                "wsl-linux-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "detail": "Configures the renderer using the WSL Linux Debug preset."
        },
        {
            "type": "process",
            "label": "Build Renderer",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "wsl-linux-debug"
            ],
            "dependsOn": "Configure Renderer",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the renderer and its shaders through CMake."
        }
    ],
    "version": "2.0.0"
}
