#version 460
#extension GL_EXT_ray_tracing : require

// Ray tracing uses its own set 0; set 1 reuses the renderer's camera uniform.
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outputImage;

layout(set = 1, binding = 0, std140) uniform Ubo {
    mat4 projection;
    mat4 model;
    mat4 view;
    vec3 cameraPos;
    float nearPlane;
    float farPlane;
    mat4 invProjection;
} ubo;

layout(location = 0) rayPayloadEXT vec3 radiance;

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 extent = imageSize(outputImage);
    if (any(greaterThanEqual(pixel, extent)))
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    // The camera projection already includes Vulkan's Y flip.
    vec4 viewRay = ubo.invProjection * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 viewDirection = normalize(viewRay.xyz);
    vec3 direction = normalize(transpose(mat3(ubo.view)) * viewDirection);

    // Convert view-space clipping planes to distances along the normalized ray.
    float clipScale = 1.0 / max(-viewDirection.z, 0.0001);
    radiance = vec3(0.0);
    // One opaque triangle hit group and one miss record; no recursive rays.
    traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                ubo.cameraPos, ubo.nearPlane * clipScale,
                direction, ubo.farPlane * clipScale, 0);
    imageStore(outputImage, pixel, vec4(radiance, 1.0));
}
